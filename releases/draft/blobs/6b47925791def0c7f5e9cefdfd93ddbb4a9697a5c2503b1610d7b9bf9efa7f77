            "type": "string",
            "description": "Label"
          }
        },
        "warehouse": {
          "type": "string",
          "description": "Warehouse code the change applies to.",
          "default": "MAIN"
        }
      },
      "required": [
        "sku",
        "delta",
        "reason"
      ]
    }
  }
]

Request: Record a stock change of -26 units on SKU 003231, reason: sale, in warehouse EAST-2.

Reply with only a JSON array of the tool calls that fulfil the request, each of the form {"name": "<tool name>", "arguments": {...}}, where "arguments" is a JSON object (not a string). When the request needs several calls, list them all. Reply with [] if no tool fits the request, or if the request does not give a value for a required argument: never guess one. Include every required argument. Include an optional argument only if the request asks for a value for it; otherwise leave it out and the tool applies its default. Give each value the type its schema declares: JSON numbers for integer and number, true or false for boolean, and strings for string, copied exactly as written.