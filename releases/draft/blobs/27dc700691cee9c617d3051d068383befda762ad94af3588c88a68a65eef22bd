[{"content":"You can call these tools (parameters are JSON Schema; \"required\" lists the required arguments, and \"default\" is the value used when an optional argument is left out):\n\n[\n  {\n    \"name\": \"searchUsers\",\n    \"description\": \"Search user accounts by name or part of a name and return their ids, emails and roles.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"query\": {\n          \"type\": \"string\",\n          \"description\": \"Name or part of a name to search for, case-insensitive.\"\n        },\n        \"limit\": {\n          \"type\": \"integer\",\n          \"description\": \"Maximum number of accounts to return.\",\n          \"default\": 10\n        },\n        \"includeInactive\": {\n          \"type\": \"boolean\",\n          \"description\": \"Also return deactivated accounts.\",\n          \"default\": false\n        },\n        \"roles\": {\n          \"type\": \"array\",\n          \"description\": \"Only return accounts holding one of these roles, in any order.\",\n          \"items\": {\n            \"type\": \"string\",\n            \"description\": \"Role.\",\n            \"enum\": [\n              \"viewer\",\n              \"editor\",\n              \"admin\"\n            ]\n          }\n        }\n      },\n      \"required\": [\n        \"query\"\n      ]\n    }\n  },\n  {\n    \"name\": \"set_stock_level\",\n    \"description\": \"Overwrite the stock count of one SKU with an absolute number after a physical count.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"sku\": {\n          \"type\": \"string\",\n          \"description\": \"Stock-keeping unit, exactly as written, including leading zeros.\"\n        },\n        \"quantity\": {\n          \"type\": \"integer\",\n          \"description\": \"New absolute number of units on hand.\"\n        },\n        \"warehouse\": {\n          \"type\": \"string\",\n          \"description\": 