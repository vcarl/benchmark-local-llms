[{"content":"You can call these tools (parameters are JSON Schema; \"required\" lists the required arguments, and \"default\" is the value used when an optional argument is left out):\n\n[\n  {\n    \"name\": \"getFileInfo\",\n    \"description\": \"Get the metadata of one file or directory: size, owner, permissions and timestamps.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"path\": {\n          \"type\": \"string\",\n          \"description\": \"Absolute path of the file or directory to inspect.\"\n        }\n      },\n      \"required\": [\n        \"path\"\n      ]\n    }\n  },\n  {\n    \"name\": \"Flights_2_GetFlightStatus\",\n    \"description\": \"Get the live status of one scheduled flight: gate, departure and arrival times, delays or cancellation.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"flight_number\": {\n          \"type\": \"string\",\n          \"description\": \"Airline flight number, e.g. 'BA117', exactly as printed on the ticket.\"\n        },\n        \"date\": {\n          \"type\": \"string\",\n          \"description\": \"Scheduled departure date of the flight, formatted as YYYY-MM-DD.\"\n        }\n      },\n      \"required\": [\n        \"flight_number\",\n        \"date\"\n      ]\n    }\n  },\n  {\n    \"name\": \"getUserByEmail\",\n    \"description\": \"Fetch one user account of the admin console by the email address it is registered under.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"email\": {\n          \"type\": \"string\",\n          \"description\": \"Email address of the account, exactly as given.\"\n        }\n      },\n      \"required\": [\n        \"email\"\n      ]\n    }\n  },\n  {\n    \"name\": \"deleteFile\",\n    \"description\": \"Delete one file by path; by default it is moved to the trash, where it can still be restored.\",\n    \"parameters\": {\n      \"type\": \"object\",\n  