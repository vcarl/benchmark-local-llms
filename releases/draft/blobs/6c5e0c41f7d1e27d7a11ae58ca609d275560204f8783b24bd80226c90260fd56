tring\",\n          \"description\": \"Who can see the event details on shared calendars.\",\n          \"enum\": [\n            \"default\",\n            \"public\",\n            \"private\"\n          ],\n          \"default\": \"default\"\n        },\n        \"recurrence\": {\n          \"type\": \"object\",\n          \"description\": \"Repeat rule for a recurring event; a one-off event when left out.\",\n          \"properties\": {\n            \"frequency\": {\n              \"type\": \"string\",\n              \"description\": \"How often the event repeats.\",\n              \"enum\": [\n                \"daily\",\n                \"weekly\",\n                \"monthly\"\n              ]\n            },\n            \"count\": {\n              \"type\": \"integer\",\n              \"description\": \"Total number of occurrences, the first one included.\"\n            }\n          },\n          \"required\": [\n            \"frequency\",\n            \"count\"\n          ]\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"start\"\n      ]\n    }\n  },\n  {\n    \"name\": \"get_weather_forecast\",\n    \"description\": \"Get the daily weather forecast for a city, starting tomorrow, for up to ten days ahead.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"location\": {\n          \"type\": \"string\",\n          \"description\": \"City name, optionally with a country, e.g. 'Lisbon' or 'Lisbon, Portugal'.\"\n        },\n        \"days\": {\n          \"type\": \"integer\",\n          \"description\": \"Number of days to forecast, from 1 to 10, starting with tomorrow.\"\n        },\n        \"units\": {\n          \"type\": \"string\",\n          \"description\": \"Temperature unit for every value in the response: celsius or fahrenheit.\",\n          \"enum\": [\n            \"celsius\",\n            \"fahrenheit\"\n          ],\n          \"default\": \"celsius\"\n        },\n        \"hourly\": 