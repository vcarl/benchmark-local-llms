urn deactivated accounts.\",\n          \"default\": false\n        },\n        \"roles\": {\n          \"type\": \"array\",\n          \"description\": \"Only return accounts holding one of these roles, in any order.\",\n          \"items\": {\n            \"type\": \"string\",\n            \"description\": \"Role.\",\n            \"enum\": [\n              \"viewer\",\n              \"editor\",\n              \"admin\"\n            ]\n          }\n        }\n      },\n      \"required\": [\n        \"query\"\n      ]\n    }\n  },\n  {\n    \"name\": \"kube.restart_deployment\",\n    \"description\": \"Restart every pod of a Kubernetes deployment with a rolling restart, keeping the replica count.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"deployment\": {\n          \"type\": \"string\",\n          \"description\": \"Name of the deployment, exactly as given, e.g. 'checkout-api'.\"\n        },\n        \"namespace\": {\n          \"type\": \"string\",\n          \"description\": \"Kubernetes namespace the resource lives in.\",\n          \"default\": \"default\"\n        }\n      },\n      \"required\": [\n        \"deployment\"\n      ]\n    }\n  },\n  {\n    \"name\": \"convert_currency\",\n    \"description\": \"Convert an amount of money from one currency to another at today's mid-market exchange rate.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"amount\": {\n          \"type\": \"number\",\n          \"description\": \"Amount in the source currency, e.g. 250 or 99.95.\"\n        },\n        \"from_currency\": {\n          \"type\": \"string\",\n          \"description\": \"ISO 4217 code of the source currency, e.g. 'USD'.\"\n        },\n        \"to_currency\": {\n          \"type\": \"string\",\n          \"description\": \"ISO 4217 code of the target currency, e.g. 'EUR'.\"\n        }\n      },\n      \"required\": [\n        \"amount\",\n        \"from_currency\",\n 