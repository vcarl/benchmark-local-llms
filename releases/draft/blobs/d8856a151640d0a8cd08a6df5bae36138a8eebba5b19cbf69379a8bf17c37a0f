[{"content":"You can call these tools (parameters are JSON Schema; \"required\" lists the required arguments, and \"default\" is the value used when an optional argument is left out):\n\n[\n  {\n    \"name\": \"Services_1_FindProvider\",\n    \"description\": \"Search for a hair stylist in a specified city, with options to filter for unisex salons.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"city\": {\n          \"type\": \"string\",\n          \"description\": \"The city where the stylist or salon is sought, such as 'New York, NY'. State names must be abbreviated with two letters.\"\n        },\n        \"is_unisex\": {\n          \"type\": \"boolean\",\n          \"description\": \"Indicates whether the salon caters to all genders. True for yes, False for no.\",\n          \"default\": false\n        }\n      },\n      \"required\": [\n        \"city\"\n      ]\n    }\n  },\n  {\n    \"name\": \"searchFiles\",\n    \"description\": \"Find files below a directory whose names match a glob pattern, with their sizes and timestamps.\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"directory\": {\n          \"type\": \"string\",\n          \"description\": \"Absolute path of the directory to search from, e.g. '/srv/reports'.\"\n        },\n        \"pattern\": {\n          \"type\": \"string\",\n          \"description\": \"Glob pattern the file name must match, e.g. '*.csv' or 'invoice-*'.\"\n        },\n        \"recursive\": {\n          \"type\": \"boolean\",\n          \"description\": \"Search subdirectories as well as the directory itself.\",\n          \"default\": true\n        },\n        \"maxResults\": {\n          \"type\": \"integer\",\n          \"description\": \"Maximum number of matching files to return.\",\n          \"default\": 50\n        },\n        \"excludePatterns\": {\n          \"type\": \"array\",\n          \"description\": \"Glob patterns of file names